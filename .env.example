# CollabFlow Environment Variables

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=collabflow-super-secret-jwt-key-change-in-prod-123!
CORS_ORIGIN=http://localhost:3000

# Optional Persistence (Leave blank to use built-in FileStorageService)
DATABASE_URL=
# Optional Redis Queue (Leave blank to use built-in EmbeddedQueueService)
REDIS_URL=

# Web Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
